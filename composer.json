{
  "name": "allovince/evathumber",
  "description": "Self-hosted Cloudinary-compatible image transformations for PHP",
  "type": "library",
  "license": "BSD-3-Clause",
  "require": {
    "php": "~8.5.0",
    "ext-ffi": "*",
    "ext-fileinfo": "*",
    "jcupitt/vips": "^2.5",
    "symfony/http-foundation": "7.4.*",
    "symfony/http-kernel": "7.4.*",
    "symfony/routing": "7.4.*",
    "symfony/event-dispatcher": "7.4.*",
    "symfony/process": "7.4.*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {"psr-4": {"EvaThumber\\": "src/"}},
  "autoload-dev": {"psr-4": {"EvaThumber\\Tests\\": "tests/"}},
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=512M"
  },
  "config": {"sort-packages": true, "platform": {"php": "8.5.0"}}
}
